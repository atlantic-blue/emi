{
  "name": "emi",
  "private": true,
  "version": "0.0.0",
  "description": "A private period and cycle tracker.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "generate:app-icon": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types brand/icon/generate.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project features/tsconfig.json && npm run typecheck --workspaces --if-present",
    "check:documents": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/pipeline/checkDocuments.ts",
    "generate:brand": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/brand/writeBrandDocument.ts",
    "check:brand": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/brand/writeBrandDocument.ts --check",
    "generate:reference": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/documentation/writeReference.ts",
    "check:reference": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/documentation/writeReference.ts --check",
    "generate:sheet": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON brand/sheet/render.ts",
    "check:sheet": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON brand/sheet/writeSheet.ts --check",
    "check:features": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/pipeline/checkFeatureCoverage.ts",
    "check:story": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/pipeline/checkStory.ts",
    "check:pictures": "EMI_PICTURE_CHECK=1 jest --ci --config brand/screens/jest.config.js --testPathPattern '(welcome|cycleLength|pastDay).picture'",
    "generate:logo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON brand/logo/generate.ts",
    "generate:specimen": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON brand/specimen/render.ts",
    "generate:ring-picture": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON brand/ring/render.ts",
    "generate:onboarding-picture": "jest --ci --config brand/screens/jest.config.js --testPathPattern onboarding.picture",
    "generate:home-picture": "jest --ci --config brand/screens/jest.config.js --testPathPattern homeScreen.picture",
    "generate:flow-picture": "jest --ci --config brand/screens/jest.config.js --testPathPattern logFlow.picture",
    "generate:last-period-picture": "jest --ci --config brand/screens/jest.config.js --testPathPattern lastPeriod.picture",
    "generate:history-picture": "jest --ci --config brand/screens/jest.config.js --testPathPattern history.picture",
    "generate:export-picture": "jest --ci --config brand/screens/jest.config.js --testPathPattern export.picture",
    "generate:delete-picture": "jest --ci --config brand/screens/jest.config.js --testPathPattern deleteEverything.picture",
    "generate:welcome-picture": "jest --ci --config brand/screens/jest.config.js --testPathPattern welcome.picture",
    "generate:cycle-length-picture": "jest --ci --config brand/screens/jest.config.js --testPathPattern cycleLength.picture",
    "generate:past-day-picture": "jest --ci --config brand/screens/jest.config.js --testPathPattern pastDay.picture",
    "test": "npm run test:workspace && npm run test:mobile && npm run test:behaviour",
    "test:workspace": "jest --ci --config jest.node.config.js",
    "test:mobile": "npm test --workspace apps/mobile",
    "test:behaviour": "npm run test:behaviour --workspace apps/mobile"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@mermaid-js/mermaid-cli": "11.17.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/babel__core": "7.20.5",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.3",
    "@types/react": "~19.2.2",
    "babel-jest": "29.7.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "jest": "29.7.0",
    "jest-cucumber": "^4.5.0",
    "prettier": "3.9.7",
    "typescript": "~6.0.3",
    "yaml": "2.9.1"
  }
}
